{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "typeRoots": ["../mcp/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "vitest": ["../mcp/node_modules/vitest"]
    },
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "../tests/*.ts", "../tests/helpers"]
}
