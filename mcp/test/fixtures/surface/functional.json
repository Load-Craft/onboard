            "enum": ["summary", "flows", "one", "http_log"]
          },
          "result_id": {
            "description": "With view one: the result.",
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "log_type": {
            "description": "With view http_log: which part.",
            "type": "string",
            "enum": ["request", "response", "log"]
          },
          "limit": {
            "default": 50,
            "description": "How many entries to return (1-200).",
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "required": ["run_id"],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_get_runs",
      "title": "Get functional runs",
      "description": "Get functional runs: list (filter by status or type), by run template, or one with its status.",
      "annotations": {
        "readOnlyHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "description": "One functional run; without it, the list.",
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "view": {
            "default": "list",
            "description": "list (default), one run, or the runs of a template.",
            "type": "string",
            "enum": ["list", "one", "by_template"]
          },
          "template": {
            "description": "With view by_template: the template.",
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "status": {
            "description": "Only runs in this status.",
            "type": "string",
            "enum": ["pending", "running", "completed", "failed", "cancelled"]
          },
          "type": {
            "description": "Only ad hoc or template runs.",
            "type": "string",
            "enum": ["adhoc", "template"]
          },
          "limit": {
            "default": 20,
            "description": "How many runs to return (1-100).",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "The first run of the list.",
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_get_templates",
