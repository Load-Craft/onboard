            "minLength": 1,
            "maxLength": 200
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_save_template",
      "title": "Save a functional test template",
      "description": "Save a functional test template (no id: create).",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
