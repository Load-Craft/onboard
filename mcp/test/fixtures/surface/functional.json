            "description": "One entry (id; for assertion types also the name); without it, the list.",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "description": "Only this category.",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "is_active": {
            "description": "Only active (true) or inactive (false) entries; not for assertion types.",
            "type": "boolean"
          },
          "limit": {
            "default": 50,
            "description": "How many entries to return (1-200).",
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "required": ["kind"],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_get_flows",
      "title": "Get functional test flows",
      "description": "Get functional test flows (block graphs, per docs version): list, one, or version history.",
