    {
      "name": "functional_save_catalog",
      "title": "Save a custom catalog entry",
      "description": "Save a custom catalog entry (base test type, base validator or assertion type; no id: create). The catalog is shared by all projects.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["catalog_test_type", "catalog_validator", "catalog_assertion_type"],
            "description": "Which shared catalog: base test type, base validator or assertion type."
          },
          "entry_id": {
            "description": "The entry to change; without it, a new one is created.",
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "name": {
            "description": "The entry's name; required for a new one.",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "fields": {
            "description": "Fields to set: the create or update body of that catalog.",
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "expected_outcome": {
                "type": "string"
              },
              "input_generation_prompt": {
                "type": "string"
              },
              "input_schema": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "example_inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "is_active": {
                "type": "boolean"
              },
              "validator_type": {
                "type": "string",
                "enum": ["assertion", "ai_semantic"]
              },
              "activation": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "requires_profile_flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ai_prompt_template": {
                "type": "string"
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "prompt_template": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "required": ["kind"],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_save_flow",
      "title": "Save a functional test flow",
