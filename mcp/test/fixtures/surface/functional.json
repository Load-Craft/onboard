{
  "tools": [
    {
      "name": "functional_compare_runs",
      "title": "Compare two functional runs block by block",
      "description": "Compare two functional runs block by block: status, response shape, timing.",
      "annotations": {
        "readOnlyHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "description": "The functional run."
          },
          "other": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "description": "The run to compare with."
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "required": ["run_id", "other"],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_delete",
      "title": "Delete a functional item",
      "description": "Delete one functional flow, template, test type, validator, run or catalog entry (kind + item_id).",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "flow",
              "template",
              "test_type",
              "validator",
              "run",
              "catalog_test_type",
              "catalog_validator",
              "catalog_assertion_type"
            ],
            "description": "What to delete."
          },
          "item_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "description": "The item to delete (one per call)."
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "required": ["kind", "item_id"],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_generate_payloads",
      "title": "Generate request payloads for flows and test types",
      "description": "Generate request payloads for flows and test types; saves the ZIP to a local file and returns its path.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "flow_ids": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            },
            "description": "The flows to generate for (key: flow id; value: {}); 1-50."
          },
          "test_types": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "description": "The test types to use (key: test type id; value: number of cases per flow, 1-20); 1-50."
          },
          "file": {
            "description": "Where to save the ZIP: a relative path inside the project directory; default: loadcraft/payloads/<run>.zip. Never overwrites a file.",
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "required": ["flow_ids", "test_types"],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_generate_test_types",
      "title": "Generate the missing base test types",
      "description": "Generate all missing base test types for the project; the LLM fills their expected outcomes.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "include_categories": {
            "description": "Comma-separated categories to generate (e.g. functional, security); default: all.",
            "type": "string",
            "maxLength": 300
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_get_analytics",
      "title": "Get validator quality over N days",
      "description": "Get validator quality over N days: dashboard, flaky validators, failure patterns, accuracy, trend, threshold suggestion (view).",
      "annotations": {
        "readOnlyHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "view": {
            "default": "dashboard",
            "description": "Which analysis; default: dashboard.",
            "type": "string",
            "enum": [
              "dashboard",
              "flaky",
              "failure_patterns",
              "accuracy",
              "trend",
              "threshold_suggestion"
            ]
          },
          "days": {
            "default": 30,
            "description": "How many past days (1-365).",
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "validator": {
            "description": "The validator (id or name); needed for accuracy, trend and threshold_suggestion.",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "threshold_pct": {
            "default": 20,
            "description": "With view flaky: the flakiness threshold in percent.",
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_get_catalog",
      "title": "Get the global catalog of base test types",
      "description": "Get the global catalog of base test types, base validators or assertion types: list, one item, categories, built-in seed status.",
      "annotations": {
