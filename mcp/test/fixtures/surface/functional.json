                  "additionalProperties": {}
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "entry_block_id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "variables": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "retry_delay_ms": {
                "type": "integer",
