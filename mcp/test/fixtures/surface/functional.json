          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "functional_get_results",
      "title": "Get the results of a functional run",
      "description": "Get the results of a functional run: summary with flow results, one flow result, or the captured HTTP log (secrets masked).",
      "annotations": {
        "readOnlyHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "description": "The functional run."
          },
          "view": {
            "default": "summary",
            "description": "summary (default), per flow, one result, or the HTTP log.",
