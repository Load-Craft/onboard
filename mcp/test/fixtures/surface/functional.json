          },
          "name": {
            "description": "The flow's name; required for a new flow.",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "docs_id": {
            "description": "The API docs of a new flow; default: the active docs.",
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "fields": {
            "description": "Fields to set: blocks, edges, entry_block_id, description, tags, variables, timeout_ms, retry_count, retry_delay_ms, is_active.",
            "type": "object",
            "properties": {
              "blocks": {
                "type": "array",
