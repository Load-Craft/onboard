{
  "tools": [
    {
      "name": "process_set_choices",
      "title": "Set user decisions",
      "description": "Set user decisions (flow method, journeys, traffic split, environment, load profile, run target) that module tools use as defaults.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "choices": {
            "type": "object",
            "properties": {
              "flows": {
                "type": "object",
                "properties": {
                  "method": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["suggestions", "endpoints", "har", "description"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "journeys": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 200
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "har_split": {
                    "type": ["boolean", "null"]
                  },
                  "account_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "scenario": {
                "type": "object",
                "properties": {
                  "split": {
                    "anyOf": [
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "additionalProperties": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "data_mix": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": ["normal", "realistic"]
                          },
                          {
                            "type": "object",
                            "propertyNames": {
                              "type": "string",
                              "maxLength": 64
                            },
                            "additionalProperties": {
                              "type": "number"
                            }
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "composition_name": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "run": {
                "type": "object",
                "properties": {
                  "target": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": ["scenario", "composition"]
                          },
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          }
                        },
                        "required": ["kind", "id"],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "env_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "profile": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "maxLength": 32
                          },
                          "vusers": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000
                          },
                          "ramp": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 86400
                          },
                          "hold": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 86400
                          }
                        },
                        "required": ["type", "vusers"],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "traffic_snapshot_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "compare_to": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          {
                            "type": "string",
                            "const": "baseline"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "data": {
                "type": "object",
                "properties": {
                  "needs_accounts": {
                    "type": ["boolean", "null"]
                  }
                },
                "additionalProperties": false
              },
              "functional": {
                "type": "object",
                "properties": {
                  "flow_ids": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "test_type_ids": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "env_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "description": "The decisions to set, by group (flows, scenario, run, data, functional) and field, for example {\"flows\":{\"method\":\"har\"}}; a field set to null is cleared."
          },
          "format": {
            "default": "text",
            "description": "Read-only choice of the answer: \"text\" (default) is the view; \"data\" is the same facts as one JSON block, for a client that parses them.",
            "type": "string",
            "enum": ["text", "data"]
          }
        },
        "required": ["choices"],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    }
  ]
}
