{
  "name": "@loadcraft/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LoadCraft MCP server (stdio) used by the LoadCraft plugin",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "lint": "node scripts/parallel.mjs \"eslint .\" \"cd ../mod && eslint .\" \"prettier --check .\" \"prettier --check --config .prettierrc.json ../mod/src ../mod/test ../mod/tests ../mod/scripts ../mod/types ../mod/eslint.config.js\" \"madge --circular --extensions ts src ../mod/src\"",
    "typecheck": "node scripts/parallel.mjs \"tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-mcp.tsbuildinfo\" \"tsc --noEmit -p ../mod --incremental --tsBuildInfoFile node_modules/.cache/tsc-mod.tsbuildinfo\"",
    "test": "vitest run",
    "update:shared": "UPDATE_SHARED=1 vitest run test/sharedLists.test.ts",
    "test:related": "vitest related --run --passWithNoTests=false",
    "test:skills": "vitest run --config ../validators/vitest.config.mts",
    "update:surface": "UPDATE_SURFACE=1 vitest run test/surface.baseline.test.ts && prettier --write test/fixtures/surface-baseline.json test/fixtures/surface",
    "format": "prettier --write .",
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/check-dist.mjs && npm run check:catalog && node ../validators/scripts/check-skills.mjs",
    "build:skills": "node ../validators/scripts/build.mjs",
    "check:skills": "node ../validators/scripts/check-skills.mjs",
    "build:mod": "node ../mod/scripts/build-mod.mjs",
    "check:mod": "node ../mod/scripts/check-mod.mjs",
    "test:mod": "node ../mod/scripts/test-mod.mjs",
    "gen:api": "node scripts/gen-api.mjs && node scripts/gen-operations.mjs",
    "check:api": "node scripts/gen-api.mjs --check && node scripts/gen-operations.mjs --check",
    "check:names": "node scripts/check-names.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs && node scripts/gen-tools.mjs",
    "check:catalog": "node scripts/gen-catalog.mjs --check && node scripts/gen-tools.mjs --check",
    "gen:tools": "node scripts/gen-tools.mjs",
    "gen:ws": "node scripts/gen-clients.mjs --only ws",
    "check:ws": "node scripts/gen-clients.mjs --only ws --check",
    "gen:clients": "node scripts/gen-clients.mjs && node scripts/gen-operations.mjs",
    "check:clients": "node scripts/gen-clients.mjs --check && node scripts/gen-operations.mjs --check",
    "sync:api": "node scripts/sync-api.mjs",
    "fake": "node scripts/fake-backend.mjs",
    "gate": "node scripts/live-gate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "openapi-fetch": "0.17.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.6",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@redocly/openapi-core": "1.34.24",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "madge": "8.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
