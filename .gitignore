__pycache__/
.claude/settings.local.json
.DS_Store
mcp/node_modules
# Type declarations Claude Code writes beside the mod when it loads the plugin folder interactively.
.claude-plugin/types/
# Reports of the live gate (mcp/scripts/live-gate.ts); they name the backend and the project of a run.
mcp/gate-reports/
# Results of claude plugin eval (evals/README.md); they hold transcripts of the runs.
evals/results/
# The session file a case with context.history_file resumes: the run writes its transcript beside history.jsonl.
evals/*/[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*.jsonl
