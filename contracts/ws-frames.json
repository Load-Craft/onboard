{
  "$comment": "WebSocket frames the LoadCraft plugin reads and sends. Only keys the plugin reads are listed; other keys may be present and are ignored. Key types: string, integer, boolean, object, array. required=false means the key may be absent; nullable=true means null is accepted.",
  "version": 1,
  "channels": {
    "refine": {
      "path": "/ws/flow-suggestions-refine/{job_id}",
      "envelope": "payload",
      "requires": "none",
      "close_codes": {
        "4404": "unknown job; an error frame with reason job_not_found precedes the close"
      },
      "notes": "The current job state is sent right after the connection opens. Client messages are ignored.",
      "server": [
        {
          "type": "flow-suggestions-refine:progress",
          "keys": [
            { "name": "job_id", "type": "string", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "progress", "type": "integer", "required": true },
            { "name": "current_step", "type": "string", "required": false },
            { "name": "step_label", "type": "string", "required": false },
            {
              "name": "described",
              "type": "integer",
              "required": false,
              "nullable": true
            },
            {
              "name": "total",
              "type": "integer",
              "required": false,
              "nullable": true
            }
          ]
        },
        {
          "type": "flow-suggestions-refine:complete",
          "keys": [
            { "name": "job_id", "type": "string", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "result", "type": "object", "required": true }
          ]
        },
        {
          "type": "flow-suggestions-refine:error",
          "keys": [
            { "name": "job_id", "type": "string", "required": true },
            {
              "name": "error",
              "type": "string",
              "required": true,
              "nullable": true
            },
            {
              "name": "recoverable",
              "type": "boolean",
              "required": false,
              "nullable": true
            },
            {
              "name": "reason",
              "type": "string",
              "required": false,
              "nullable": true
            }
          ]
        },
        {
          "type": "flow-suggestions-refine:cancelled",
          "keys": [{ "name": "job_id", "type": "string", "required": true }]
        }
      ],
      "client": []
    },
    "batch": {
      "path": "/ws/batch-generation/{run_id}",
      "envelope": "payload",
      "requires": "none",
      "close_codes": {
        "4404": "unknown run; an error frame with reason run_not_found precedes the close"
      },
      "notes": "After the connection opens the last event of every basket is replayed in request order, then the run end if it has ended. Client messages are ignored.",
      "server": [
        {
          "type": "batch-generation:basket-progress",
          "keys": [
            { "name": "basket_id", "type": "string", "required": true },
            { "name": "step_label", "type": "string", "required": false },
            { "name": "progress", "type": "integer", "required": false }
          ]
        },
        {
          "type": "batch-generation:basket-complete",
          "keys": [
            { "name": "basket_id", "type": "string", "required": true },
            { "name": "flow_id", "type": "string", "required": true },
            { "name": "flow_name", "type": "string", "required": false },
            {
              "name": "needs_input",
              "type": "array",
              "required": false,
              "nullable": true
            }
          ]
        },
        {
          "type": "batch-generation:basket-error",
          "keys": [
            { "name": "basket_id", "type": "string", "required": true },
            { "name": "error", "type": "string", "required": true },
            { "name": "retryable", "type": "boolean", "required": false }
          ]
        },
        {
          "type": "batch-generation:complete",
          "keys": [
            { "name": "success_count", "type": "integer", "required": true },
            { "name": "failed_count", "type": "integer", "required": true }
          ]
        },
        {
          "type": "batch-generation:error",
          "keys": [
            {
              "name": "error",
              "type": "string",
              "required": true,
              "nullable": true
            },
            {
              "name": "recoverable",
              "type": "boolean",
              "required": false,
              "nullable": true
            },
            {
              "name": "reason",
              "type": "string",
              "required": false,
              "nullable": true
            },
            { "name": "success_count", "type": "integer", "required": false },
            { "name": "failed_count", "type": "integer", "required": false }
          ]
        }
      ],
      "client": []
    },
    "scenario": {
      "path": "/ws/gatling-scenario/{run_id}",
      "envelope": "payload",
      "requires": "none",
      "close_codes": {},
      "notes": "Only the last terminal frame of a run is replayed to a socket opened after the run ended; progress frames are not replayed. Client messages are ignored.",
      "server": [
        {
          "type": "gatling-scenario:progress",
          "keys": [
            { "name": "progress", "type": "integer", "required": true },
            { "name": "current_step", "type": "string", "required": false },
            { "name": "step_label", "type": "string", "required": false },
            { "name": "planner_path", "type": "string", "required": false },
            {
              "name": "planner_path_reason",
              "type": "string",
              "required": false
            }
          ]
        },
        {
          "type": "gatling-scenario:complete",
          "keys": [
            { "name": "run_id", "type": "string", "required": false },
            { "name": "scenario_id", "type": "string", "required": true }
          ]
        },
        {
          "type": "gatling-scenario:error",
          "keys": [
            { "name": "error", "type": "string", "required": true },
            { "name": "recoverable", "type": "boolean", "required": false },
            { "name": "status_code", "type": "integer", "required": false }
          ]
        },
        {
          "type": "gatling-scenario:cancelled",
          "keys": [{ "name": "run_id", "type": "string", "required": false }]
        }
      ],
      "client": []
    },
    "analysis": {
      "path": "/ws/gatling-analysis/{run_id}",
      "envelope": "payload",
      "requires": "none",
      "close_codes": {},
      "notes": "Frames are not replayed after the run ended; the stored analysis is read over REST. Client messages are ignored.",
      "server": [
        {
          "type": "gatling-analysis:progress",
          "keys": [
            { "name": "progress", "type": "integer", "required": true },
            { "name": "current_step", "type": "string", "required": false },
            { "name": "step_label", "type": "string", "required": false }
          ]
        },
        {
          "type": "gatling-analysis:complete",
          "keys": [
            { "name": "run_id", "type": "string", "required": false },
            { "name": "analysis", "type": "object", "required": true }
          ]
        },
        {
          "type": "gatling-analysis:error",
          "keys": [
            { "name": "error", "type": "string", "required": true },
            { "name": "recoverable", "type": "boolean", "required": false }
          ]
        }
      ],
      "client": []
    },
    "har": {
      "path": "/ws/projects/{pid}/har/{sid}",
      "envelope": "payload",
      "requires": "identity",
      "identity": "Authorization: Bearer header",
      "close_codes": {
        "4001": "no identity presented",
        "4003": "no access to the project"
      },
      "notes": "The sid in the path is the HAR session id returned by the REST upload. split_proposal is sent without an envelope. A second har:generate while generating is ignored.",
      "server": [
        {
          "type": "har:progress",
          "keys": [
            { "name": "status", "type": "string", "required": false },
            { "name": "progress", "type": "integer", "required": true },
            { "name": "current_step", "type": "string", "required": false },
            { "name": "step_label", "type": "string", "required": false }
          ]
        },
        {
          "type": "split_proposal",
          "envelope": "flat",
          "keys": [
            {
              "name": "proposed_paths",
              "type": "array",
              "required": true,
              "items": [
                { "name": "name", "type": "string", "required": true },
                { "name": "steps", "type": "array", "required": true },
                {
                  "name": "depends_on_prior",
                  "type": "boolean",
                  "required": false
                },
                { "name": "rationale", "type": "string", "required": false }
              ]
            }
          ]
        },
        {
          "type": "har:complete",
          "keys": [
            { "name": "session_id", "type": "string", "required": false },
            { "name": "status", "type": "string", "required": false },
            { "name": "flow_id", "type": "string", "required": false },
            { "name": "flow_name", "type": "string", "required": false },
            {
              "name": "flows",
              "type": "array",
              "required": false,
              "nullable": true,
              "items": [
                { "name": "flow_id", "type": "string", "required": true },
                { "name": "flow_name", "type": "string", "required": true }
              ]
            }
          ]
        },
        {
          "type": "har:error",
          "keys": [
            { "name": "error", "type": "string", "required": true },
            { "name": "recoverable", "type": "boolean", "required": false }
          ]
        },
        {
          "type": "har:cancelled",
          "keys": [
            { "name": "session_id", "type": "string", "required": false }
          ]
        }
      ],
      "client": [
        {
          "type": "har:generate",
          "envelope": "flat",
          "keys": [
            { "name": "flow_name", "type": "string", "required": true },
            { "name": "action_groups", "type": "array", "required": false },
            {
              "name": "rejected_correlations",
              "type": "array",
              "required": false
            },
            {
              "name": "excluded_entry_indices",
              "type": "array",
              "required": false
            },
            { "name": "auth_username", "type": "string", "required": false },
            { "name": "auth_password", "type": "string", "required": false }
          ]
        },
        {
          "type": "split_resume",
          "envelope": "flat",
          "keys": [
            {
              "name": "paths",
              "type": "array",
              "required": true,
              "items": [
                { "name": "name", "type": "string", "required": true },
                { "name": "steps", "type": "array", "required": true }
              ]
            }
          ]
        },
        {
          "type": "har:cancel",
          "envelope": "flat",
          "keys": []
        }
      ]
    },
    "describe": {
      "path": "/ws/projects/{pid}/scenario-from-description/runs/{run_id}",
      "envelope": "flat",
      "requires": "identity_and_origin",
      "identity": "Authorization: Bearer header",
      "origin": "Origin header present, with the same host and port as the Host header",
      "close_codes": {
        "4001": "no identity presented",
        "4003": "origin not accepted, or no access to the project",
        "4404": "unknown run"
      },
      "notes": "Frames are flat objects: the type and its keys sit side by side, with no payload wrapper. A late socket gets the terminal frame of the run, and drive_snapshot while a drive is in progress.",
      "server": [
        {
          "type": "split_proposal",
          "keys": [
            {
              "name": "proposed_paths",
              "type": "array",
              "required": true,
              "items": [
                { "name": "name", "type": "string", "required": true },
                { "name": "steps", "type": "array", "required": true },
                {
                  "name": "depends_on_prior",
                  "type": "boolean",
                  "required": false
                },
                {
                  "name": "creates_own_identity",
                  "type": "boolean",
                  "required": false
                }
              ]
            },
            { "name": "shared_sign_in", "type": "boolean", "required": false }
          ]
        },
        {
          "type": "drive_snapshot",
          "keys": [
            { "name": "setup", "type": "string", "required": true },
            {
              "name": "paths",
              "type": "array",
              "required": true,
              "items": [
                { "name": "path_index", "type": "integer", "required": true },
                { "name": "name", "type": "string", "required": false },
                { "name": "state", "type": "string", "required": true },
                {
                  "name": "stop_cause",
                  "type": "string",
                  "required": false,
                  "nullable": true
                },
                {
                  "name": "reason",
                  "type": "string",
                  "required": false,
                  "nullable": true
                },
                { "name": "not_driven", "type": "boolean", "required": false }
              ]
            }
          ]
        },
        {
          "type": "path_stage",
          "keys": [
            { "name": "path_index", "type": "integer", "required": true },
            { "name": "attempt", "type": "integer", "required": false },
            { "name": "stage", "type": "string", "required": true }
          ]
        },
        {
          "type": "path_done",
          "keys": [
            { "name": "path_index", "type": "integer", "required": true },
            { "name": "path_name", "type": "string", "required": false }
          ]
        },
        {
          "type": "path_failed",
          "keys": [
            { "name": "path_index", "type": "integer", "required": true },
            { "name": "path_name", "type": "string", "required": false },
            { "name": "reason", "type": "string", "required": false },
            { "name": "attempt", "type": "integer", "required": false },
            { "name": "will_retry", "type": "boolean", "required": true },
            { "name": "not_driven", "type": "boolean", "required": false }
          ]
        },
        {
          "type": "agent_step",
          "keys": [
            {
              "name": "step",
              "type": "object",
              "required": true,
              "items": [
                { "name": "path_index", "type": "integer", "required": true },
                {
                  "name": "attempt",
                  "type": "integer",
                  "required": false,
                  "nullable": true
                },
                {
                  "name": "step_number",
                  "type": "integer",
                  "required": false,
                  "nullable": true
                },
                { "name": "label", "type": "string", "required": true },
                {
                  "name": "plan_step_index",
                  "type": "integer",
                  "required": false,
                  "nullable": true
                },
                { "name": "outcome", "type": "string", "required": true },
                {
                  "name": "failure",
                  "type": "string",
                  "required": false,
                  "nullable": true
                }
              ]
            }
          ]
        },
        {
          "type": "help_requested",
          "keys": [
            { "name": "path_index", "type": "integer", "required": true },
            { "name": "attempt", "type": "integer", "required": false },
            { "name": "reason", "type": "string", "required": true },
            {
              "name": "agent_says",
              "type": "string",
              "required": false,
              "nullable": true
            },
            {
              "name": "expires_at",
              "type": "string",
              "required": false,
              "nullable": true
            }
          ]
        },
        {
          "type": "control_returned",
          "keys": [
            { "name": "path_index", "type": "integer", "required": true },
            { "name": "attempt", "type": "integer", "required": false },
            { "name": "reason", "type": "string", "required": true },
            {
              "name": "choice",
              "type": "string",
              "required": false,
              "nullable": true
            },
            {
              "name": "obstacle_kind",
              "type": "string",
              "required": false,
              "nullable": true
            }
          ]
        },
        {
          "type": "stop_accepted",
          "keys": [
            { "name": "reason", "type": "string", "required": false },
            {
              "name": "path_index",
              "type": "integer",
              "required": false,
              "nullable": true
            },
            {
              "name": "attempt",
              "type": "integer",
              "required": false,
              "nullable": true
            }
          ]
        },
        {
          "type": "stop_refused",
          "keys": [{ "name": "code", "type": "string", "required": true }]
        },
        {
          "type": "split_resume_refused",
          "keys": [
            {
              "name": "detail",
              "type": "object",
              "required": true,
              "items": [
                { "name": "error", "type": "string", "required": false },
                { "name": "message", "type": "string", "required": false },
                { "name": "limit", "type": "integer", "required": false }
              ]
            }
          ]
        },
        {
          "type": "message_denied",
          "keys": [
            {
              "name": "message_type",
              "type": "string",
              "required": false,
              "nullable": true
            },
            { "name": "code", "type": "string", "required": true }
          ]
        },
        {
          "type": "complete",
          "keys": [{ "name": "result", "type": "object", "required": true }]
        },
        {
          "type": "error",
          "keys": [
            { "name": "error", "type": "string", "required": true },
            {
              "name": "node",
              "type": "string",
              "required": false,
              "nullable": true
            },
            {
              "name": "technical",
              "type": "string",
              "required": false,
              "nullable": true
            }
          ]
        },
        {
          "type": "cancelled",
          "keys": []
        },
        {
          "type": "interrupted",
          "keys": [
            {
              "name": "error",
              "type": "string",
              "required": false,
              "nullable": true
            }
          ]
        }
      ],
      "client": [
        {
          "type": "split_resume",
          "keys": [
            {
              "name": "paths",
              "type": "array",
              "required": true,
              "items": [
                { "name": "name", "type": "string", "required": true },
                { "name": "steps", "type": "array", "required": true },
                {
                  "name": "depends_on_prior",
                  "type": "boolean",
                  "required": false
                }
              ]
            }
          ]
        },
        {
          "type": "stop",
          "keys": []
        }
      ]
    },
    "healthCheck": {
      "path": "/ws/health-check/{session_id}",
      "envelope": "flat",
      "requires": "none",
      "close_codes": {},
      "notes": "Streams a health check started by POST /api/scenarios/{scenario_id}/health-check with the session_id the caller chose. Nothing is sent on connect and earlier frames are not replayed: connect first. A check already running is not stopped by cancel.",
      "server": [
        {
          "type": "progress",
          "keys": [
            { "name": "node", "type": "string", "required": true },
            { "name": "progress", "type": "integer", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "details", "type": "object", "required": false }
          ]
        },
        {
          "type": "complete",
          "keys": [{ "name": "result", "type": "object", "required": true }]
        },
        {
          "type": "error",
          "keys": [
            { "name": "error", "type": "string", "required": true },
            {
              "name": "node",
              "type": "string",
              "required": false,
              "nullable": true
            },
            {
              "name": "technical",
              "type": "string",
              "required": false,
              "nullable": true
            }
          ]
        },
        {
          "type": "cancelled",
          "keys": []
        }
      ],
      "client": [
        {
          "type": "cancel",
          "keys": []
        }
      ]
    },
    "testTypes": {
      "path": "/ws/test-types/{run_id}",
      "envelope": "payload",
      "requires": "none",
      "close_codes": {},
      "notes": "Streams an AI test type run started by POST /api/v1/projects/{project_id}/test-types/suggest-async or generate-async. Nothing is sent on connect and earlier frames are not replayed: frames sent before the socket joined are lost, and GET .../test-types/suggest/{run_id} holds the outcome of both modes. Client messages are not read.",
      "server": [
        {
          "type": "test-types:progress",
          "keys": [
            { "name": "current_step", "type": "string", "required": true },
            { "name": "mode", "type": "string", "required": true },
            { "name": "progress", "type": "integer", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "step_label", "type": "string", "required": true }
          ]
        },
        {
          "type": "test-types:complete",
          "keys": [
            { "name": "mode", "type": "string", "required": true },
            { "name": "omitted_operations", "type": "array", "required": true },
            { "name": "run_id", "type": "string", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "created", "type": "integer", "required": false },
            {
              "name": "rationale",
              "type": "string",
              "required": false,
              "nullable": true
            },
            { "name": "skipped", "type": "integer", "required": false },
            {
              "name": "soft_error_status_path",
              "type": "string",
              "required": false,
              "nullable": true
            },
            { "name": "suggestions", "type": "array", "required": false },
            { "name": "test_types", "type": "array", "required": false },
            { "name": "total", "type": "integer", "required": false },
            { "name": "uses_soft_errors", "type": "boolean", "required": false }
          ]
        },
        {
          "type": "test-types:error",
          "keys": [
            { "name": "error", "type": "string", "required": true },
            { "name": "mode", "type": "string", "required": true },
            { "name": "recoverable", "type": "boolean", "required": true }
          ]
        }
      ],
      "client": []
    },
    "payloadGen": {
      "path": "/ws/payload-gen/{run_id}",
      "envelope": "payload",
      "requires": "none",
      "close_codes": {},
      "notes": "Streams payload generation started by POST /api/v1/projects/{project_id}/generate-payloads-async; after complete the ZIP is fetched once from GET .../generate-payloads/{run_id}/download. Nothing is sent on connect and earlier frames are not replayed. Client messages are not read.",
      "server": [
        {
          "type": "payload-gen:progress",
          "keys": [
            { "name": "current_step", "type": "string", "required": true },
            { "name": "progress", "type": "integer", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "step_label", "type": "string", "required": true }
          ]
        },
        {
          "type": "payload-gen:complete",
          "keys": [
            { "name": "run_id", "type": "string", "required": true },
            { "name": "status", "type": "string", "required": true }
          ]
        },
        {
          "type": "payload-gen:error",
          "keys": [
            { "name": "error", "type": "string", "required": true },
            { "name": "recoverable", "type": "boolean", "required": true }
          ]
        }
      ],
      "client": []
    },
    "gatlingFeeder": {
      "path": "/ws/gatling-feeder/{run_id}",
      "envelope": "payload",
      "requires": "none",
      "close_codes": {},
      "notes": "Progress of AI dataset generation started by POST /feeders/generate-async; run_id is the one that request returns. Accepted immediately; frames sent before the connect are lost and not replayed. Client messages are ignored.",
      "server": [
        {
          "type": "gatling-feeder:progress",
          "keys": [
            { "name": "progress", "type": "integer", "required": true },
            { "name": "current_step", "type": "string", "required": false },
            { "name": "step_label", "type": "string", "required": false }
          ]
        },
        {
          "type": "gatling-feeder:complete",
